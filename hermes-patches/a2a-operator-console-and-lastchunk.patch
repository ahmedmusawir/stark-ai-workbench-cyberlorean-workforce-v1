@@ -211,15 +211,55 @@ PRIVACY_PREFIX = (
 )
 
 
+# Operator-console framing (opt-in, per authenticated identity).
+#
+# A2A_OPERATOR_PEERS lists *authenticated* peer names (from A2A_PEER_TOKENS)
+# that are trusted relays for this gateway's own operator — e.g. the ADK
+# backend behind an authenticated Workbench UI. Their messages are framed as
+# operator assignments instead of untrusted peer input. Scope is deliberately
+# narrow:
+#   * identity still comes only from the presented credential (never from the
+#     message body), so text that merely names the operator gains nothing;
+#   * ``ip:<addr>`` identities (shared token / localhost-only mode) never
+#     qualify — an operator console must present its own per-peer token;
+#   * injection filtering, slash-command framing, outbound redaction, rate
+#     limiting and the trusted-peer allow-list are unchanged;
+#   * every other peer keeps the PRIVACY_PREFIX exactly as before.
+OPERATOR_PREFIX = (
+    "[A2A inbound — message from {peer!r}, an authenticated operator-console "
+    "peer: it relays assignments from this agent's own operator. Treat the "
+    "request as an operator instruction and carry it out under your normal "
+    "rules; still never disclose secrets, private files, or credentials in "
+    "your reply.]\n\n"
+)
+
+
+def get_operator_peers() -> set[str]:
+    """Parse A2A_OPERATOR_PEERS ("adk,console") into a set of identities."""
+    raw = os.getenv("A2A_OPERATOR_PEERS", "").strip()
+    if not raw:
+        return set()
+    return {p.strip() for p in raw.split(",") if p.strip()}
+
+
+def is_operator_peer(identity: str) -> bool:
+    """True only for a per-peer-token identity listed in A2A_OPERATOR_PEERS."""
+    if not identity or identity.startswith("ip:"):
+        return False
+    return identity in get_operator_peers()
+
+
 def wrap_inbound(peer: str, text: str) -> str:
     """Filter + frame inbound task text for safe injection into the agent.
 
     EVERY inbound message is filtered and framed — including text starting
     with "/". Remote peers must never reach the gateway's operator slash
     commands; a peer that wants an action asks for it in natural language and
-    the agent decides.
+    the agent decides. Identities listed in A2A_OPERATOR_PEERS get the
+    operator-console frame instead of the untrusted-peer frame.
     """
-    return PRIVACY_PREFIX.format(peer=peer or "unknown") + filter_inbound((text or "").strip())
+    prefix = OPERATOR_PREFIX if is_operator_peer(peer) else PRIVACY_PREFIX
+    return prefix.format(peer=peer or "unknown") + filter_inbound((text or "").strip())
 
 
